{
  "version": 1,
  "agents": [
    { "name": "implementor", "file": "implementor.md", "opencode": {} },
    { "name": "researcher", "file": "researcher.md", "opencode": { "description": "Read-only research and investigation. Traces how code works, maps dependencies, reads docs and git history, and reports evidence-backed findings. Cannot edit. The default investigator for \"how does X work\", \"where is Y handled\", or \"trace this code path\".", "permission": { "edit": "deny", "webfetch": "allow", "task": "deny" } } },
    { "name": "scout", "file": "scout.md", "opencode": { "permission": { "edit": "deny", "bash": "deny", "webfetch": "deny", "task": "deny" } } },
    { "name": "librarian", "file": "librarian.md" },
    { "name": "reviewer", "file": "reviewer.md" },
    { "name": "conductor", "file": "conductor.md" },
    { "name": "plan", "file": "plan.md", "hosts": ["opencode"], "opencode_full": { "path": ".opencode/agents/plan.md", "mode": "primary", "permission": {
      "edit": { "*": "deny", "{{PROJECT_DIR}}/.sterling/plans/*": "allow" },
      "task": { "*": "deny", "sterling/scout": "allow", "sterling/researcher": "allow", "sterling/reviewer": "allow", "sterling/implementor": "deny" },
      "bash": { "*": "deny", "node {{STERLING_ROOT}}/bin/plan-lock.mjs --bind-pending": "allow", "node {{STERLING_ROOT}}/bin/plan-lock.mjs --bind-pending --force": "allow", "node {{STERLING_ROOT}}/bin/plan-lock.mjs --show": "allow", "mkdir -p {{PROJECT_DIR}}/.sterling/plans": "allow", "git status": "allow", "git diff --stat": "allow", "git log --oneline -20": "allow" }
    } } }
  ]
}
